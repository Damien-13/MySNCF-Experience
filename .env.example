# Copier ce fichier en .env et renseigner les valeurs (ne jamais commiter .env)

# Dossier de destination des données téléchargées
DATA_DIR=data

# Datasets à télécharger : une variable DATASET_<SOURCE>_URL par lien de téléchargement.
# <SOURCE> donne le nom du sous-dossier créé dans DATA_DIR (en minuscules).
# Les archives .zip sont décompressées dans ce sous-dossier.
# DATASET_REGULARITE_URL=https://example.org/regularite.csv
# DATASET_GARES_URL=https://example.org/gares.zip

