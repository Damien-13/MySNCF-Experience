# Configuration de MySNCF Experience : copier ce fichier en .env

# Clé de l'API SNCF, gratuite : https://numerique.sncf.com/startup/api/token-developpeur/
NAVITIA_TOKEN=

# Dossier des données téléchargées
DATA_DIR=data

# Sources de données : chaque DATASET_<SOURCE>_URL est téléchargée dans data/<source>/ (archives .zip décompressées).
# Les sources chargées dans la base sont la liste SOURCES de src/initialize.py ; les autres sont gardées pour la suite.

